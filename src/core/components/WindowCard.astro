---
import type { Window } from '../db/schema';
import { hourMinute, pad3 } from '../format';

interface Props {
	window: Window;
	stats: { ideas: number; votes: number; people: number };
}

const { window, stats } = Astro.props;
const left = Math.max(0, Date.parse(window.closesAt) - Date.now());
const seconds = Math.ceil(left / 1000);
const pad = (n: number) => String(n).padStart(2, '0');
const hh = pad(Math.floor(seconds / 3600));
const mm = pad(Math.floor((seconds % 3600) / 60));
const ss = pad(seconds % 60);
const total = Date.parse(window.closesAt) - Date.parse(window.openedAt);
const done = total > 0 ? Math.min(100, Math.max(0, ((Date.now() - Date.parse(window.openedAt)) / total) * 100)) : 0;
---

<aside
	aria-label="Next build"
	data-countdown
	data-essential="countdown"
	data-closes-at={window.closesAt}
	data-opened-at={window.openedAt}
	data-server-now={Date.now()}
	class="group flex min-w-0 flex-[1_1_380px] flex-col justify-between gap-7 border-2 border-ink bg-ink p-8 text-white shadow-blue"
	style="container-type: inline-size"
>
	<div class="flex items-center justify-between font-mono text-[13px] tracking-[0.08em] text-silver uppercase">
		<span>Next build in</span>
		<span class="text-accent">● cycle {pad3(window.number)}</span>
	</div>
	<div
		class="flex items-baseline gap-1.5 font-display leading-none font-bold tracking-[-0.03em] tabular-nums"
		style="font-size: clamp(32px, 21cqi, 96px)"
		role="timer"
		aria-label="Time until voting closes"
	>
		<span data-countdown-hh>{hh}</span><span class="text-accent">:</span><span data-countdown-mm>{mm}</span><span
			class="text-accent">:</span
		><span data-countdown-ss>{ss}</span>
	</div>
	<div class="flex flex-col gap-2.5">
		<div class="h-2.5 border border-[#3a3f46] bg-[#2b2f35]">
			<div data-countdown-bar class="pw-stripes h-full" style={`width: ${done.toFixed(2)}%`}></div>
		</div>
		<div class="flex justify-between font-mono text-[12px] text-silver">
			<span>window opened <span data-local-time={window.openedAt}>{hourMinute(window.openedAt)}</span></span>
			<span>closes <span data-local-time={window.closesAt}>{hourMinute(window.closesAt)}</span></span>
		</div>
	</div>
	<p class="m-0 text-base leading-normal text-[#d9dce0]">
		<span class="group-data-[ended=true]:hidden">
			The idea with the most votes ships when this hits zero. Nobody can skip the line — not even us.
		</span>
		<span class="hidden group-data-[ended=true]:inline">Voting closed. Counting the votes…</span>
	</p>
	<p class="m-0 border-t border-night-line pt-4 font-mono text-[13px] text-silver">
		{
			[
				`${stats.ideas} ${stats.ideas === 1 ? 'idea' : 'ideas'}`,
				`${stats.votes} ${stats.votes === 1 ? 'vote' : 'votes'}`,
				`${stats.people} ${stats.people === 1 ? 'person' : 'people'}`,
			].join(' · ')
		}
	</p>
</aside>

<script>
	import { startCountdowns } from '../cycle/countdown';
	startCountdowns();
</script>
