---
import { SITE_NAME } from '../site';

interface Props {
	dark?: boolean;
}

const { dark = false } = Astro.props;
---

<a
	href="/"
	class="flex items-center gap-2.5 no-underline hover:text-inherit"
	aria-label={`${SITE_NAME}, home`}
	data-essential="logo"
>
	<span
		class:list={[
			'flex size-[34px] items-end bg-accent p-1 box-border border-2',
			dark ? 'border-white' : 'border-ink',
		]}
	>
		<span class="pw-caret block h-[3px] w-[9px] bg-ink"></span>
	</span>
	<span
		class:list={['font-display text-[22px] font-extrabold tracking-[-0.02em]', dark ? 'text-white' : 'text-ink']}
	>
		{SITE_NAME.toUpperCase()}
	</span>
</a>
