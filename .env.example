# A local setup. The server's environment template is kept outside this repository.

# Use 127.0.0.1, not localhost: X accepts only that callback and cookies are per host.
HOST=127.0.0.1
PORT=4321
SITE_URL=http://127.0.0.1:4321

# SQLite file on local disk.
DATABASE_URL=file:data/local.db

# OAuth apps. A provider is enabled only when both its id and secret are set.
# Callback for each: $SITE_URL/api/auth/<provider>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

# Voting windows are 360 minutes. Set it lower to watch a whole cycle quickly.
# WINDOW_MINUTES=5

# Build pipeline.
#   preview    = dry run in the runner clone
#   local      = also apply the change to this repository and check the running dev server
#   production = for a server: build, restart and check the site after each change
DEPLOY_MODE=preview

# What runs the build agent: cli = Claude Code on a signed-in subscription (a laptop),
# sdk = the Anthropic API with ANTHROPIC_API_KEY (a server).
# AGENT_RUNTIME=cli
# AGENT_EFFORT=medium

# After each build the site is opened in a real browser to check that sign-in, navigation
# and the rest are still in place. Needs Chrome or Chromium; set CHROME_PATH if it isn't
# found, or BROWSER_CHECK=off to skip the check on purpose.
# BROWSER_CHECK=required
# CHROME_PATH=
# CYCLE_POLL_MS=30000
# LIVE_URL=http://127.0.0.1:4321

# AI review of ideas. cli = logged-in Claude Code (a laptop), api = the Anthropic API with
# ANTHROPIC_API_KEY (a server), off = no AI check.
MODERATION_PROVIDER=cli
# ANTHROPIC_API_KEY=
# Only if the key isn't scoped to a workspace (the API then says so): the workspace's ID, wrkspc_…
# ANTHROPIC_WORKSPACE_ID=
# MODERATION_MODEL=claude-haiku-5-5
# MODERATION_TIMEOUT_MS=15000
# FINAL_GATE_MODEL=claude-sonnet-5-5
# FINAL_GATE_TIMEOUT_MS=120000
