# Use 127.0.0.1, not localhost: X accepts only that callback and cookies are per host.
HOST=127.0.0.1
PORT=4321
SITE_URL=http://127.0.0.1:4321

# SQLite file on local disk.
DATABASE_URL=file:data/local.db

# OAuth apps. A provider is enabled only when both its id and secret are set.
# Callback for each: $SITE_URL/api/auth/<provider>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

# Build pipeline. preview = dry run in the runner clone; local = also apply the
# change to this repository and check the running site, reverting it if it broke.
DEPLOY_MODE=preview
# After each build the site is opened in a real browser to check that sign-in, navigation
# and the rest are still in place. Needs Chrome or Chromium; set CHROME_PATH if it isn't
# found, or BROWSER_CHECK=off to skip the check on purpose.
# BROWSER_CHECK=required
# CHROME_PATH=
# CYCLE_POLL_MS=30000
# LIVE_URL=http://127.0.0.1:4321

# AI moderation. cli = logged-in Claude Code (local), api = Anthropic SDK with
# ANTHROPIC_API_KEY (servers), off = no AI check.
MODERATION_PROVIDER=cli
# ANTHROPIC_API_KEY=
# MODERATION_MODEL=claude-haiku-5-5
# MODERATION_TIMEOUT_MS=15000
# FINAL_GATE_MODEL=claude-sonnet-5-5
# FINAL_GATE_TIMEOUT_MS=120000
